# Browser-safe Vite values. These are compiled into the public website.
VITE_LEAD_CAPTURE_ENDPOINT=/api/leads/v1/consultations
VITE_LEAD_CAPTURE_TIMEOUT_MS=12000
VITE_ODOO_CAMPAIGN_CODE=CODESTRA-WEB-AI
VITE_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY VALUES — never prefix these with VITE_ and never expose them to
# the website container, browser bundle, public CI logs, or client-side runtime.
# Configure them on the private lead-intake adapter service.
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql://codestra_leads:change-me@postgres:5432/codestra_leads
PUBLIC_ORIGINS=https://codestra.co,https://www.codestra.co
TRUST_PROXY_HEADERS=true

# Safe activation gates. Keep false until migrations, Odoo mapping, gateway
# policy, canary evidence, rollback, and an authorized production approval exist.
ODOO_WRITE_ENABLED=false
N8N_DELIVERY_ENABLED=false

# Odoo 19 JSON-2 API. Use a dedicated least-privilege service user/API key.
ODOO_BASE_URL=https://odoo.internal.example
ODOO_DATABASE=codestra
ODOO_API_KEY=
ODOO_EXTERNAL_ID_FIELD=x_codestra_external_lead_id
ODOO_CAMPAIGN_MAP_JSON={"CODESTRA-WEB-AI": 1}
ODOO_SOURCE_MAP_JSON={"website": 1}
ODOO_REQUEST_TIMEOUT_SECONDS=12

# Cloudflare Turnstile server-side validation.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=codestra.co,www.codestra.co
TURNSTILE_REQUIRED=true
MINIMUM_FORM_DWELL_MS=1500

# Durable n8n outbox delivery. The URL must be private or authenticated.
N8N_WEBHOOK_URL=
N8N_SIGNING_SECRET=
N8N_REQUEST_TIMEOUT_SECONDS=10
N8N_OUTBOX_POLL_SECONDS=2
N8N_OUTBOX_MAX_ATTEMPTS=12

# Operations.
IDEMPOTENCY_LEASE_SECONDS=45
COMMAND_RETENTION_DAYS=365
OUTBOX_RETENTION_DAYS=90
