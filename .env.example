# These values are compiled into the browser bundle and must never be secrets.
VITE_API_ENDPOINT=https://api.codestra.co

# Optional legacy API logout/revocation path. Keep empty until the backend
# publishes and certifies its canonical logout contract.
VITE_AUTH_LOGOUT_ENDPOINT=

# Migration authority for the production identity model.
VITE_OIDC_ISSUER=https://auth.codestra.co/realms/codestra
VITE_OIDC_CLIENT_ID=codestra-web-production
